# Скопируй в apps/server/.env и заполни.

# Локальная PostgreSQL (установщик для Windows: https://www.postgresql.org/download/windows/)
# или публичный URL базы на Railway.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trektren_dev
# true для Railway и других облачных баз с SSL.
DATABASE_SSL=false

# Минимум 32 случайных символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

PORT=3000
CORS_ORIGIN=http://localhost:5173
# strict — когда клиент и API на одном домене (dev через прокси Vite и прод с CLIENT_DIST_DIR).
COOKIE_SAMESITE=strict

# Прод: отдавать собранный клиент с того же сервера.
# CLIENT_DIST_DIR=../client/dist
# За прокси Railway — 1, чтобы rate limit видел реальный IP.
# TRUST_PROXY=1
